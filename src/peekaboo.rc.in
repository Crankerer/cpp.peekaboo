// Generated by CMake from src/peekaboo.rc.in - do not edit the copy in the
// build directory. Paths are absolute because the resource compiler cannot be
// given an include path here: windres hands them to its preprocessor unquoted,
// and a space in one fails the build.

// 101 is IDI_PEEKABOO from src/resource.hpp, spelled out for the same reason.
101 ICON "@PEEKABOO_ICON_FILE@"

1 VERSIONINFO
FILEVERSION @PEEKABOO_VERSION_MAJOR@, 0, 0, 0
PRODUCTVERSION @PEEKABOO_VERSION_MAJOR@, 0, 0, 0
FILEOS 0x4L         // VOS_NT
FILETYPE 0x1L       // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // US English, Unicode
        BEGIN
            VALUE "FileDescription", "PeekaBoo - Quick Look for Windows"
            VALUE "FileVersion", "@PEEKABOO_VERSION@"
            VALUE "InternalName", "peekaboo"
            VALUE "OriginalFilename", "peekaboo.exe"
            VALUE "ProductName", "PeekaBoo"
            VALUE "ProductVersion", "@PEEKABOO_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
